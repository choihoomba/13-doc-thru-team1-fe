# .env.example

# PORT=3000
# - Next.js는 .env의 PORT를 자동으로 안 읽음 (package.json dev 스크립트 미사용)
# - 불필요해서 제거

# DATABASE_URL
# - 프론트는 DB에 직접 연결하지 않음 (백엔드 전용 값, 잘못 복사됨)
# - 제거

# CLIENT_URL
# - CORS 허용은 백엔드가 프론트 주소를 지정하는 값 (백엔드 전용)
# - 제거

BACKEND_URL=http://localhost:4000
# - 프록시(app/api/[...path]/route.js)가 백엔드로 요청 전달할 때만 사용
# - 브라우저는 이 주소를 모름, 클라이언트 요청은 전부 상대경로(/api/...)로만 나감